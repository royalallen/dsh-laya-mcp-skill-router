{
  "name": "dsh-dynamic-router",
  "version": "0.5.0",
  "description": "Per-turn tool and skill router for DeepSeek Harness: local embeddings/BM25 recall plus Laya decisions pick which tools and skills reach the model, so a remote Ollama gets a small, cache-stable context.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "laya",
    "mcp",
    "agent-skills",
    "tool-router"
  ],
  "license": "MIT",
  "author": "royalallen",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "cordis.patch.yml",
    "eval",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royalallen/dsh-dynamic-router.git"
  },
  "homepage": "https://github.com/royalallen/dsh-dynamic-router#readme",
  "bugs": {
    "url": "https://github.com/royalallen/dsh-dynamic-router/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "eval": "node eval/run.js"
  }
}
